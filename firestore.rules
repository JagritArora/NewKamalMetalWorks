rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMaster() {
      return request.auth != null
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == "master";
    }

    // A rate-card write is only allowed within a short window after the
    // requestRateCardCode / verifyRateCardCode Cloud Functions confirmed a
    // code emailed to the signed-in master. Those functions write
    // verifiedUntil via the Admin SDK, which bypasses these rules -- the
    // rateCardVerify collection itself is unreadable and unwritable by any
    // client below, so this can't be forged from the browser console.
    function rateCardVerified() {
      return isMaster()
        && exists(/databases/$(database)/documents/rateCardVerify/$(request.auth.uid))
        && get(/databases/$(database)/documents/rateCardVerify/$(request.auth.uid)).data.verifiedUntil != null
        && request.time < get(/databases/$(database)/documents/rateCardVerify/$(request.auth.uid)).data.verifiedUntil;
    }

    match /profiles/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isMaster());

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == "client";

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    // Billing -- rate cards, invoice history, and the invoice-number
    // counter. Master (owner) only; clients never touch any of this.
    match /buyers/{buyerId} {
      allow read, write: if isMaster();

      // Rate-card entries themselves additionally require a freshly
      // emailed, verified code -- see rateCardVerified() above.
      match /parts/{partNo} {
        allow read: if isMaster();
        allow write: if isMaster() && rateCardVerified();
      }
    }

    // Written only by requestRateCardCode / verifyRateCardCode (Cloud
    // Functions, Admin SDK) -- never by a client, in either direction.
    match /rateCardVerify/{uid} {
      allow read, write: if false;
    }

    match /invoices/{invoiceId} {
      allow read, write: if isMaster();
    }

    match /counters/{financialYear} {
      allow read, write: if isMaster();
    }

    // Queued by billing.html, sent by the sendMail Cloud Function (which
    // uses the Admin SDK and bypasses these rules entirely). Clients only
    // ever create here -- never read/update/delete -- so nobody but the
    // function itself can see or tamper with an in-flight send.
    match /mail/{mailId} {
      allow create: if isMaster();
    }
  }
}
